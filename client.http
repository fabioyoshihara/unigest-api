@baseUrl = http://localhost:3000

# Credenciais de um usuário existente no banco
@loginEmail = admin.sistema@unigest.edu.br
@loginPassword = Admin@2026

# Valores únicos para os exemplos
@uniq = 001
@cpf11 = 12345678901
@cnpj14 = 12345678000190

# Capturados automaticamente das respostas (rode o request nomeado antes)
@token = {{login.response.body.$.token}}
@userId = {{createUser.response.body.$.id}}
@otherUserId = {{createOtherUser.response.body.$.id}}
@courseId = {{createCourse.response.body.$.courseId}}
@studentId = {{createStudent.response.body.$.studentId}}
@registrationNumber = {{createStudent.response.body.$.registrationNumber}}
@supplierId = {{createSupplier.response.body.$.supplierId}}
@teacherId = {{createTeacher.response.body.$.id}}
@classId = {{createClass.response.body.$.id}}



# =====================================================================
#  AUTH
# =====================================================================

### Login (captura o token automaticamente)
# @name login
POST {{baseUrl}}/api/v1/login
Content-Type: application/json

{
  "email": "{{loginEmail}}",
  "password": "{{loginPassword}}"
}

### Login - senha inválida (esperado 400)
POST {{baseUrl}}/api/v1/login
Content-Type: application/json

{
  "email": "{{loginEmail}}",
  "password": "senha-errada"
}


# =====================================================================
#  HEALTH
# =====================================================================

### Health check
GET {{baseUrl}}/


# =====================================================================
#  USERS
# =====================================================================

### Create user (captura userId)
# @name createUser
POST {{baseUrl}}/api/v1/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "Carlos",
  "lastName": "Mendes",
  "personalEmail": "carlos.{{uniq}}@gmail.com"
}

### Create user - e-mail pessoal duplicado (esperado 409)
POST {{baseUrl}}/api/v1/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "Carlos",
  "lastName": "Mendes",
  "personalEmail": "carlos.{{uniq}}@gmail.com"
}

### Create user B (captura otherUserId)
# @name createOtherUser
POST {{baseUrl}}/api/v1/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "Beatriz",
  "lastName": "Lima",
  "personalEmail": "beatriz.{{uniq}}@gmail.com"
}

### Get users
GET {{baseUrl}}/api/v1/users
Authorization: Bearer {{token}}

### Get user by ID
GET {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{token}}

### Put user
PUT {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "Carlos",
  "lastName": "Mendes Filho",
  "personalEmail": "carlos.filho.{{uniq}}@gmail.com",
  "role": "coordination"
}

### Patch user
PATCH {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role": "finance"
}

### Patch user - e-mail pessoal de outro usuário (esperado 409)
PATCH {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "personalEmail": "beatriz.{{uniq}}@gmail.com"
}

### Delete user
DELETE {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{token}}

### Delete user B
DELETE {{baseUrl}}/api/v1/users/{{otherUserId}}
Authorization: Bearer {{token}}


# =====================================================================
#  COURSES
# =====================================================================

### Create course (captura courseId)
# @name createCourse
POST {{baseUrl}}/api/v1/courses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Ciência da Computação",
  "workloadHours": 3200,
  "durationSemesters": 8,
  "modality": "hybrid"
}

### Create course - modality inválida (esperado 400)
POST {{baseUrl}}/api/v1/courses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Curso X",
  "workloadHours": 3200,
  "durationSemesters": 8,
  "modality": "ead"
}

### Get courses
GET {{baseUrl}}/api/v1/courses
Authorization: Bearer {{token}}

### Get course by ID
GET {{baseUrl}}/api/v1/courses/{{courseId}}
Authorization: Bearer {{token}}

### Put course
PUT {{baseUrl}}/api/v1/courses/{{courseId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Ciência da Computação (2026)",
  "workloadHours": 3000,
  "durationSemesters": 8,
  "modality": "in_person"
}

### Patch course
PATCH {{baseUrl}}/api/v1/courses/{{courseId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "modality": "online"
}

### Delete course
DELETE {{baseUrl}}/api/v1/courses/{{courseId}}
Authorization: Bearer {{token}}


# =====================================================================
#  STUDENTS
# =====================================================================

### Create student (captura studentId e registrationNumber)
# @name createStudent
POST {{baseUrl}}/api/v1/students
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "João Pereira",
  "cpf": "{{cpf11}}",
  "email": "joao.{{uniq}}@aluno.edu.br",
  "phone": "(11) 95555-0000",
  "secondaryPhone": "(11) 3333-0000",
  "address": "Rua B, 200 - São Paulo/SP",
  "admissionDate": "2026-02-01",
  "birthDate": "2003-05-14",
  "gender": "male",
  "nationality": "Brasileira",
  "naturalness": "São Paulo/SP",
  "emergencyContact": "Maria Pereira - (11) 94444-0000"
}

### Create student - CPF duplicado (esperado 409)
POST {{baseUrl}}/api/v1/students
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "João Pereira",
  "cpf": "{{cpf11}}",
  "email": "joao.{{uniq}}@aluno.edu.br",
  "phone": "(11) 95555-0000",
  "secondaryPhone": "(11) 3333-0000",
  "address": "Rua B, 200 - São Paulo/SP",
  "admissionDate": "2026-02-01",
  "birthDate": "2003-05-14",
  "gender": "male",
  "nationality": "Brasileira",
  "naturalness": "São Paulo/SP",
  "emergencyContact": "Maria Pereira - (11) 94444-0000"
}

### Create student - sem emergencyContact (esperado 400)
POST {{baseUrl}}/api/v1/students
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Sem Contato",
  "cpf": "99999999999",
  "email": "sem.contato@aluno.edu.br",
  "phone": "1",
  "address": "Rua X",
  "admissionDate": "2026-02-01",
  "birthDate": "2003-05-14"
}

### Get students
GET {{baseUrl}}/api/v1/students
Authorization: Bearer {{token}}

### Get student by ID
GET {{baseUrl}}/api/v1/students/{{studentId}}
Authorization: Bearer {{token}}

### Put student (registrationNumber vem do create)
PUT {{baseUrl}}/api/v1/students/{{studentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "João Pereira da Silva",
  "cpf": "{{cpf11}}",
  "email": "joao.{{uniq}}@aluno.edu.br",
  "phone": "(11) 95555-0000",
  "secondaryPhone": "(11) 3333-0000",
  "address": "Rua C, 300 - São Paulo/SP",
  "registrationNumber": "{{registrationNumber}}",
  "admissionDate": "2026-02-01T00:00:00.000Z",
  "birthDate": "2003-05-14",
  "gender": "male",
  "nationality": "Brasileira",
  "naturalness": "São Paulo/SP",
  "emergencyContact": "Maria Pereira - (11) 94444-0000",
  "status": "active"
}

### Patch student
PATCH {{baseUrl}}/api/v1/students/{{studentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "on_leave",
  "secondaryPhone": null
}

### Delete student
DELETE {{baseUrl}}/api/v1/students/{{studentId}}
Authorization: Bearer {{token}}


