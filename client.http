### Create supplier (captura supplierId)
# @name createSupplier
POST {{baseUrl}}/api/v1/suppliers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "legalName": "ACME Materiais de Escritório LTDA",
  "cnpj": "{{cnpj14}}",
  "stateRegistration": "123.456.789.000",
  "email": "contato.{{uniq}}@acme.com.br",
  "phone": "(11) 3000-0000",
  "address": "Av. Industrial, 500 - Guarulhos/SP",
  "category": "Material de escritório"
}

### Create supplier - CNPJ curto (esperado 400)
POST {{baseUrl}}/api/v1/suppliers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "legalName": "ACME Materiais de Escritório LTDA",
  "cnpj": "123",
  "stateRegistration": "123.456.789.000",
  "email": "contato.{{uniq}}@acme.com.br",
  "phone": "(11) 3000-0000",
  "address": "Av. Industrial, 500 - Guarulhos/SP",
  "category": "Material de escritório"
}

### Get suppliers
GET {{baseUrl}}/api/v1/suppliers
Authorization: Bearer {{token}}

### Get supplier by ID
GET {{baseUrl}}/api/v1/suppliers/{{supplierId}}
Authorization: Bearer {{token}}

### Put supplier
PUT {{baseUrl}}/api/v1/suppliers/{{supplierId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "legalName": "ACME LTDA",
  "cnpj": "{{cnpj14}}",
  "stateRegistration": "123.456.789.000",
  "email": "contato.{{uniq}}@acme.com.br",
  "phone": "(11) 3000-0000",
  "address": "Av. Brasil, 1000 - São Paulo/SP",
  "category": "Material de escritório"
}

### Patch supplier
PATCH {{baseUrl}}/api/v1/suppliers/{{supplierId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "category": "Tecnologia"
}

### Delete supplier
DELETE {{baseUrl}}/api/v1/suppliers/{{supplierId}}
Authorization: Bearer {{token}}


