### Create teacher (captura teacherId)
# @name createTeacher
POST {{baseUrl}}/api/v1/teachers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Ana Souza",
  "cpf": "{{cpf11}}",
  "rg": "12.345.678-9",
  "email": "ana.{{uniq}}@universidade.edu.br",
  "phone": "(11) 99999-0000",
  "address": "Rua das Flores, 100 - São Paulo/SP",
  "employeeNumber": "T{{uniq}}",
  "degreeLevel": "master"
}

### Create teacher - duplicado (esperado 409)
POST {{baseUrl}}/api/v1/teachers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Ana Souza",
  "cpf": "{{cpf11}}",
  "rg": "12.345.678-9",
  "email": "ana.{{uniq}}@universidade.edu.br",
  "phone": "(11) 99999-0000",
  "address": "Rua das Flores, 100 - São Paulo/SP",
  "employeeNumber": "T{{uniq}}",
  "degreeLevel": "master"
}

### Create teacher - inválido (esperado 400)
POST {{baseUrl}}/api/v1/teachers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Fulano",
  "cpf": "12345678902",
  "email": "email-invalido",
  "phone": "1",
  "address": "Rua X",
  "employeeNumber": "T0002",
  "degreeLevel": "phd"
}

### Get teachers
GET {{baseUrl}}/api/v1/teachers
Authorization: Bearer {{token}}

### Get teacher by ID
GET {{baseUrl}}/api/v1/teachers/{{teacherId}}
Authorization: Bearer {{token}}

### Put teacher
PUT {{baseUrl}}/api/v1/teachers/{{teacherId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Ana Souza Lima",
  "cpf": "{{cpf11}}",
  "rg": "12.345.678-9",
  "email": "ana.{{uniq}}@universidade.edu.br",
  "phone": "(11) 98888-0000",
  "address": "Rua das Flores, 100 - São Paulo/SP",
  "employeeNumber": "T{{uniq}}",
  "degreeLevel": "doctorate",
  "isActive": true
}

### Patch teacher
PATCH {{baseUrl}}/api/v1/teachers/{{teacherId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "phone": "(11) 97777-0000"
}

### Patch teacher - body vazio (esperado 400)
PATCH {{baseUrl}}/api/v1/teachers/{{teacherId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### Delete teacher
DELETE {{baseUrl}}/api/v1/teachers/{{teacherId}}
Authorization: Bearer {{token}}

### Patch teacher - reativar
PATCH {{baseUrl}}/api/v1/teachers/{{teacherId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isActive": true
}


# =====================================================================
#  CLASSES
# =====================================================================

### Create class (captura classId)
# @name createClass
POST {{baseUrl}}/api/v1/classes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "courseId": "{{courseId}}",
  "teacherId": "{{teacherId}}",
  "description": "Turma A - Noturno",
  "semester": "1",
  "year": 2026,
  "scheduleTime": "19:00",
  "room": "B12"
}

### Create class - sem professor
POST {{baseUrl}}/api/v1/classes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "courseId": "{{courseId}}",
  "description": "Turma B - Matutino",
  "semester": "2",
  "year": 2026,
  "scheduleTime": "08:00:00",
  "room": "A03",
  "status": "planned"
}

### Create class - courseId inexistente (esperado 400, FK)
POST {{baseUrl}}/api/v1/classes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "courseId": "00000000-0000-4000-8000-000000000000",
  "teacherId": null,
  "description": "Turma Fantasma",
  "semester": "1",
  "year": 2026,
  "scheduleTime": "19:00",
  "room": "B12"
}

### Get classes
GET {{baseUrl}}/api/v1/classes
Authorization: Bearer {{token}}

### Get class by ID
GET {{baseUrl}}/api/v1/classes/{{classId}}
Authorization: Bearer {{token}}

### Put class (teacherId omitido vira null)
PUT {{baseUrl}}/api/v1/classes/{{classId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "courseId": "{{courseId}}",
  "description": "Turma A - Noturno (atualizada)",
  "semester": "1",
  "year": 2026,
  "scheduleTime": "20:30",
  "room": "C01",
  "status": "in_progress"
}

### Patch class
PATCH {{baseUrl}}/api/v1/classes/{{classId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "room": "D07",
  "status": "completed"
}

### Patch class - remover professor
PATCH {{baseUrl}}/api/v1/classes/{{classId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "teacherId": null
}

### Delete class
DELETE {{baseUrl}}/api/v1/classes/{{classId}}
Authorization: Bearer {{token}}

